# Copy to .env.local. Never commit .env.local.

# --- Agent ---
# Required. The conversation loop runs on claude-opus-5.
ANTHROPIC_API_KEY=sk-ant-...

# --- Booking backend ---
# mock      : fixture-driven, fully offline. The default; no credentials needed.
# flight402 : the live REST API wrapping Atlas, settling in USDC via FluxA.
BOOKING_BACKEND=mock
ATRIP_ACCESS_KEY=
ATRIP_SECRET_KEY=

# Required only when BOOKING_BACKEND=flight402.
FLIGHT402_BASE_URL=https://flight402-production.up.railway.app

# A short-lived FluxA Agent Verifiable Credential. Mint with:
#   fluxa-wallet agent-vc --audience urn:flight402:api --challenge flight402 --ttl 3600
# The audience must be exactly urn:flight402:api or the API rejects it.
# Re-mint when it expires.
FLIGHT402_AGENT_VC=
